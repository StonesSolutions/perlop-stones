<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stn_licitacion_criterio_list" model="ir.ui.view">
        <field name="name">stn.licitacion.criterio.list</field>
        <field name="model">stn.licitacion.criterio</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="sinonimos" optional="show"/>
                
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_stn_licitacion_criterio" model="ir.actions.act_window">
        <field name="name">Criterios de evaluación</field>
        <field name="res_model">stn.licitacion.criterio</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
