        <field name="name">stn.licitacion.estatus.list</field>
        <field name="model">stn.licitacion.estatus</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="sinonimos" optional="show"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_stn_licitacion_estatus" model="ir.actions.act_window">
        <field name="name">Estatus del procedimiento</field>
        <field name="res_model">stn.licitacion.estatus</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
